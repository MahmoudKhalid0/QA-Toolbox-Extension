{
    "manifest_version": 3,
    "name": "QA-Toolbox",
    "version": "1.0",
    "description": "QA testing toolkit: record & auto-fill forms, AI-generated test profiles, and element inspector - with more QA utilities on the way",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "webNavigation",
        "sidePanel",
        "tabs",
        "identity",
        "identity.email"
    ],
    "oauth2": {
        "client_id": "846935486038-t98ecg6oammr0cgjf4g0tn59svcup5hs.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.appdata"
        ]
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "modules/console-capture.js",
                "modules/network-capture.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}