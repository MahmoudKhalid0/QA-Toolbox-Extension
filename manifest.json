{
    "manifest_version": 3,
    "name": "QA Testing Toolkit",
    "version": "1.0",
    "key": "",
    "description": "QA testing toolkit: record & auto-fill forms, AI-generated test profiles, and element inspector - with more QA utilities on the way",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "webNavigation",
        "sidePanel",
        "tabs",
        "cookies",
        "browsingData",
        "declarativeNetRequest",
        "identity",
        "contextMenus",
        "desktopCapture",
        "offscreen",
        "unlimitedStorage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "vendor/fontawesome/css/all.min.css",
                "vendor/fontawesome/webfonts/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "commands": {
        "capture-visible": {
            "suggested_key": { "default": "Alt+Shift+S" },
            "description": "Capture the visible area (works on Chrome's own pages too)"
        },
        "capture-delayed": {
            "suggested_key": { "default": "Alt+Shift+D" },
            "description": "Capture after the countdown"
        }
    },
    "oauth2": {
        "client_id": "846935486038-hitaeqqvr4rqv1bso3hmrgi4bejccv5l.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.appdata",
            "email"
        ]
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "modules/console-capture.js",
                "modules/network-capture.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}