# API key lives here - never commit it. Copy config.example.js to config.js and add your key.
config.js

# Extension signing keys - the private key must never be committed.
# It lives in ~/.qa-toolbox-keys/ ; only the PUBLIC key belongs in manifest.json ("key").
*.pem
*.crx

# Test tooling only (puppeteer-core, used to drive a real browser against the
# extension). Nothing the extension itself loads - it must never be committed,
# and it must never end up inside a packaged build.
node_modules/

